# Copy to .env for local development. Never commit .env: real values live in
# the secret store (see docs/database.md for where Neon credentials go).

# local | staging | production
ENV=local
HOST=0.0.0.0
PORT=8080
# error | warn | info | debug
LOG_LEVEL=info

# Pooled connection string used by the running service. On Neon this is the
# "-pooler" host of the dev branch, with sslmode=require.
DATABASE_URL=postgresql://verdale_core:CHANGE_ME@ep-your-branch-pooler.region.aws.neon.tech/verdale?sslmode=require
# Connections this process opens to the pooler.
DATABASE_POOL_MAX=10
# Direct (non-pooled) connection string, used only by Prisma Migrate,
# `npm run db:seed` and Prisma Studio. Same branch, host without "-pooler".
DIRECT_DATABASE_URL=postgresql://verdale_core:CHANGE_ME@ep-your-branch.region.aws.neon.tech/verdale?sslmode=require

# Better Stack log forwarding. Optional locally (logs go to the console);
# required for staging and production.
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGESTING_HOST=

# How long shutdown may take before the process exits anyway.
SHUTDOWN_TIMEOUT_MS=10000

# --- Accounts (M2) ---------------------------------------------------------

# Origin of the web app. The browser only talks to it (it proxies /api/* to
# Core), so cookies are first-party and OAuth comes back here.
FRONTEND_ORIGIN=http://localhost:3000
# Signs the short-lived OAuth state cookie. Required outside local: at least
# 32 random characters (openssl rand -base64 48).
SESSION_SECRET=
SESSION_TTL_DAYS=30
# true behind nginx, so rate limits see the real client address.
TRUST_PROXY=false

# Sign-in providers. A provider is on only when both values are set; set at
# least one, or nobody can log in. Register the callback URL
#   {FRONTEND_ORIGIN}/api/v1/auth/oauth/github/callback   (or .../google/callback)
# at the provider. See docs/auth.md.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Problems and submissions (M3) ----------------------------------------

# Where files go: local (a directory, for development), r2 (Cloudflare R2), or
# memory (tests). Outside local, r2 is required.
STORAGE_DRIVER=local
# For local: the directory. Judge reads tests from <dir>/tests/<sha256>, so for
# `make up` in the Judge repo use its dev/storage directory, for example
#   STORAGE_LOCAL_DIR=../Verdale-judge-service/dev/storage
# Pictures for statements go to <dir>/public/images.
STORAGE_LOCAL_DIR=.data/storage
# For r2: the S3 endpoint and a token that can read and write both buckets.
# The private bucket holds test files (Judge gets a read-only token for it);
# the public bucket holds statement pictures.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_TESTS_BUCKET=
R2_PUBLIC_BUCKET=
# The public bucket's own domain, so browsers load pictures from it. Left empty,
# Core serves them at /api/v1/assets (fine for development).
PUBLIC_ASSET_BASE_URL=
STORAGE_TIMEOUT_MS=10000
STORAGE_RETRY_ATTEMPTS=3
STORAGE_RETRY_BACKOFF_MS=200

# Judge. Core signs jobs with JUDGE_KEY_ID / JUDGE_SECRET (Judge's
# VERDALE_JUDGE_AUTH_INBOUND_KEYS) and checks results against JUDGE_CALLBACK_KEYS
# ("key-id:secret", the pair in Judge's VERDALE_JUDGE_CALLBACK_KEY_ID / _SECRET).
# Secrets are at least 32 characters. Without keys Core still accepts
# submissions and keeps them queued.
JUDGE_URL=http://localhost:8081
JUDGE_KEY_ID=
JUDGE_SECRET=
JUDGE_CALLBACK_KEYS=
# Where Judge, inside Docker, reaches Core: host.docker.internal:<PORT>. Its
# allow-list (callback.allowed_url_prefixes) must contain
# <CORE_INTERNAL_URL>/internal/judge/.
CORE_INTERNAL_URL=http://host.docker.internal:8080

