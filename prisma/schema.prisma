// Verdale Core schema. Field and column names are snake_case.
// Prisma Migrate has no automatic down migrations: fix a bad migration with
// a new forward migration (see docs/database.md).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                            String       @id @default(uuid()) @db.Uuid
  // Stored lower-case; uniqueness is case-insensitive by construction.
  email                         String       @unique @db.VarChar(254)
  username                      String       @unique @db.VarChar(32)
  display_name                  String       @db.VarChar(64)
  // Profile picture URL from the sign-in provider, refreshed at every login
  // (GRD-68). Null when the provider has none; the web app then shows initials.
  avatar_url                    String?      @db.VarChar(2048)
  // Platform administration (GRD-58), separate from the roles inside Spaces. Only the
  // command line grants it (docs/platform-admin.md).
  platform_role                 PlatformRole @default(user)
  // Suspended: every call but reading /me and signing out answers 403 ACCOUNT_SUSPENDED.
  suspended_at                  DateTime?    @db.Timestamptz(3)
  suspension_reason             String?      @db.VarChar(500)
  // Only submitting code is stopped; the rest of the account works.
  submissions_suspended_at      DateTime?    @db.Timestamptz(3)
  submissions_suspension_reason String?      @db.VarChar(500)
  created_at                    DateTime     @default(now()) @db.Timestamptz(3)
  updated_at                    DateTime     @updatedAt @db.Timestamptz(3)

  oauth_accounts        OAuthAccount[]
  sessions              Session[]
  memberships           Membership[]
  spaces_created        Space[]
  invites_sent          Invite[]            @relation("InviteCreator")
  invites_received      Invite[]            @relation("InviteInvitee")
  problems_created      Problem[]
  solutions_added       ReferenceSolution[]
  submissions           Submission[]
  track_memberships     TrackMember[]
  audit_entries         AuditLog[]
  generate_jobs_created GenerateJob[]       @relation("GenerateJobAuthor")
  ai_credentials        UserAiCredential[]
  ai_test_jobs_created  AiTestJob[]         @relation("AiTestJobAuthor")
  verification_runs     VerificationRun[]   @relation("VerificationRequester")
  history_entries       ProblemHistory[]    @relation("HistoryActor")
  legal_acceptances     LegalAcceptance[]
  reports_made          ProblemReport[]     @relation("ReportReporter")
  reports_resolved      ProblemReport[]     @relation("ReportResolver")
  platform_audit        PlatformAuditLog[]

  @@map("users")
}

// Login identity at an OAuth provider (GRD-10: OAuth only, no passwords).
model OAuthAccount {
  id                  String   @id @default(uuid()) @db.Uuid
  user_id             String   @db.Uuid
  provider            String   @db.VarChar(16) // github | google
  provider_account_id String   @db.VarChar(128)
  created_at          DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_account_id])
  @@index([user_id])
  @@map("oauth_accounts")
}

// Server-side session. Only the SHA-256 of the cookie token is stored, so a
// database leak does not give out usable sessions.
model Session {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  token_hash String   @unique @db.VarChar(64)
  created_at DateTime @default(now()) @db.Timestamptz(3)
  expires_at DateTime @db.Timestamptz(3)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("sessions")
}

enum LegalDocument {
  terms
  privacy
}

/// Which version of the Terms or Privacy Policy a user accepted, and when
/// (GRD-122). Nothing else is stored: no IP address, no user agent. The
/// version is the document's effective date (YYYY-MM-DD, see
/// src/constants/legal.ts). One row per user, document and version; a new
/// version of a document means a new row, and the old rows stay as history.
model LegalAcceptance {
  user_id     String        @db.Uuid
  document    LegalDocument
  version     String        @db.VarChar(10)
  accepted_at DateTime      @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, document, version])
  @@map("legal_acceptances")
}

enum SpaceVisibility {
  public
  private
}

// Order of power: owner > administrator > editor > observer > solver.
// A visitor or a signed-in non-member is a "viewer": not a stored role.
enum SpaceRole {
  owner
  administrator
  editor
  observer
  solver
}

enum InviteStatus {
  pending
  accepted
  declined
  revoked
}

model Space {
  id                String          @id @default(uuid()) @db.Uuid
  // Who created it. The owner is the one membership with role = owner (exactly
  // one; ownership can be handed over); this column never changes.
  created_by_id     String          @db.Uuid
  name              String          @db.VarChar(80)
  // Lower-case; shares one namespace with usernames (a personal Space's slug
  // is its owner's username), so URLs like /<slug> never collide.
  slug              String          @unique @db.VarChar(32)
  description       String          @default("") @db.VarChar(500)
  visibility        SpaceVisibility @default(private)
  is_personal       Boolean         @default(false)
  archived_at       DateTime?       @db.Timestamptz(3)
  // Suspended by the platform (GRD-58): nobody reaches it, members included, until restored.
  suspended_at      DateTime?       @db.Timestamptz(3)
  suspension_reason String?         @db.VarChar(500)
  created_at        DateTime        @default(now()) @db.Timestamptz(3)
  updated_at        DateTime        @updatedAt @db.Timestamptz(3)

  created_by  User         @relation(fields: [created_by_id], references: [id])
  memberships Membership[]
  invites     Invite[]
  problems    Problem[]
  tracks      Track[]
  collections Collection[]
  audit_log   AuditLog[]

  @@index([visibility, archived_at])
  @@map("spaces")
}

model Membership {
  id        String    @id @default(uuid()) @db.Uuid
  space_id  String    @db.Uuid
  user_id   String    @db.Uuid
  role      SpaceRole
  joined_at DateTime  @default(now()) @db.Timestamptz(3)

  space Space @relation(fields: [space_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([space_id, user_id])
  @@index([user_id])
  @@map("memberships")
}

// An invitation is either a link (invitee_id null, anyone holding the link can
// accept once) or addressed to one user (invitee_id set, only they can respond).
// Expiry is expires_at; "expired" is never stored.
model Invite {
  id            String       @id @default(uuid()) @db.Uuid
  space_id      String       @db.Uuid
  created_by_id String       @db.Uuid
  invitee_id    String?      @db.Uuid
  // Set for a Track invitation (GRD-80): accepting joins the Track, and the
  // Space too as a solver when the person is not a member yet.
  track_id      String?      @db.Uuid
  token_hash    String       @unique @db.VarChar(64)
  role          SpaceRole
  status        InviteStatus @default(pending)
  expires_at    DateTime     @db.Timestamptz(3)
  created_at    DateTime     @default(now()) @db.Timestamptz(3)
  responded_at  DateTime?    @db.Timestamptz(3)

  space      Space  @relation(fields: [space_id], references: [id], onDelete: Cascade)
  created_by User   @relation("InviteCreator", fields: [created_by_id], references: [id])
  invitee    User?  @relation("InviteInvitee", fields: [invitee_id], references: [id], onDelete: Cascade)
  track      Track? @relation(fields: [track_id], references: [id], onDelete: Cascade)

  @@index([track_id, status])
  @@index([space_id, status])
  @@index([invitee_id, status])
  @@map("invites")
}

// --- Problems (M3: GRD-21) --------------------------------------------------

enum Language {
  c
  cpp
  python
}

// draft: never published. published: solvers can see and submit.
// archived: was published, no longer accepts submissions (readable by link).
enum ProblemStatus {
  draft
  published
  archived
}

// draft -> verifying -> verified -> published (GRD-50). A published version's
// Major fields never change (services and a trigger); only a Minor update edits
// its Minor fields in place.
enum ProblemVersionStatus {
  draft
  verifying
  verified
  published
}

enum VerificationStatus {
  queued
  running
  passed
  failed
  error
}

enum ProblemHistoryType {
  minor_update
  major_draft_created
  major_draft_discarded
  state_change
}

enum StatementMode {
  markdown
  pdf
}

model Problem {
  id                 String        @id @default(uuid()) @db.Uuid
  space_id           String        @db.Uuid
  created_by_id      String        @db.Uuid
  // Unique inside its Space; part of the URL /spaces/<space>/problems/<slug>.
  slug               String        @db.VarChar(64)
  status             ProblemStatus @default(draft)
  // The version solvers see: the draft while never published, then the
  // newest published version. A newer draft does not replace it until it is
  // published. Set in the same transaction that creates the first version.
  current_version_id String?       @unique @db.Uuid
  archived_at        DateTime?     @db.Timestamptz(3)
  // Taken down by the platform (GRD-58): while set, `status` is draft (so solvers cannot
  // reach it) although its version stays published; restoring puts `published` back.
  suspended_at       DateTime?     @db.Timestamptz(3)
  suspension_reason  String?       @db.VarChar(500)
  created_at         DateTime      @default(now()) @db.Timestamptz(3)
  updated_at         DateTime      @updatedAt @db.Timestamptz(3)

  space              Space               @relation(fields: [space_id], references: [id], onDelete: Cascade)
  created_by         User                @relation(fields: [created_by_id], references: [id])
  current_version    ProblemVersion?     @relation("CurrentVersion", fields: [current_version_id], references: [id], onDelete: SetNull)
  versions           ProblemVersion[]    @relation("VersionOfProblem")
  submissions        Submission[]
  collection_entries CollectionProblem[]
  history            ProblemHistory[]
  reports            ProblemReport[]

  @@unique([space_id, slug])
  // Problem lists of a Space by status, newest change first.
  @@index([space_id, status, updated_at(sort: Desc)])
  @@index([created_by_id, status])
  @@map("problems")
}

model ProblemVersion {
  id                       String               @id @default(uuid()) @db.Uuid
  problem_id               String               @db.Uuid
  // The Major (v1.0 is the first publish). A new Major is a new row.
  version_number           Int
  // Bumped by each Minor update of a published version; 0 on a new Major.
  minor                    Int                  @default(0)
  status                   ProblemVersionStatus @default(draft)
  title                    String               @db.VarChar(200)
  // Markdown with KaTeX maths. Drafts may be empty; publishing requires text.
  statement                String               @default("")
  // How the statement is given (GRD-73): Markdown text, or an uploaded PDF in
  // the private bucket (`statements/<sha256>`). Sample tests are separate
  // either way. Part of the version, so frozen with it.
  statement_mode           StatementMode        @default(markdown)
  statement_pdf_sha256     String?              @db.VarChar(64)
  statement_pdf_size_bytes Int?
  statement_pdf_pages      Int?
  time_limit_ms            Int
  memory_limit_kb          Int
  allowed_languages        Language[]
  created_at               DateTime             @default(now()) @db.Timestamptz(3)
  updated_at               DateTime             @updatedAt @db.Timestamptz(3)
  published_at             DateTime?            @db.Timestamptz(3)

  problem             Problem             @relation("VersionOfProblem", fields: [problem_id], references: [id], onDelete: Cascade)
  current_of          Problem?            @relation("CurrentVersion")
  test_cases          TestCase[]
  reference_solutions ReferenceSolution[]
  submissions         Submission[]
  generate_jobs       GenerateJob[]
  ai_test_jobs        AiTestJob[]
  verification_runs   VerificationRun[]
  history             ProblemHistory[]

  @@unique([problem_id, version_number])
  @@map("problem_versions")
}

// A run of the reference solution against every test on Judge (GRD-51). Bound
// to the content it was started with by `content_hash`; a later change to the
// tests, solutions, limits or languages makes it stale.
model VerificationRun {
  id                 String             @id @default(uuid()) @db.Uuid
  problem_version_id String             @db.Uuid
  requested_by_id    String             @db.Uuid
  status             VerificationStatus @default(queued)
  content_hash       String             @db.VarChar(64)
  judge_job_id       String?            @unique @db.Uuid
  verdict            Verdict?
  reason             String?            @db.VarChar(500)
  // [{ position, verdict, time_ms, memory_kb, is_sample }]
  results            Json               @default("[]")
  tests_total        Int
  tests_passed       Int?
  max_time_ms        Int?
  max_memory_kb      Int?
  attempts           Int                @default(0)
  next_dispatch_at   DateTime?          @db.Timestamptz(3)
  created_at         DateTime           @default(now()) @db.Timestamptz(3)
  finished_at        DateTime?          @db.Timestamptz(3)
  // After this the run is closed as an error, so a version never sticks in `verifying`.
  deadline_at        DateTime           @db.Timestamptz(3)

  version      ProblemVersion @relation(fields: [problem_version_id], references: [id], onDelete: Cascade)
  requested_by User           @relation("VerificationRequester", fields: [requested_by_id], references: [id])

  @@index([problem_version_id, created_at(sort: Desc)])
  @@index([status, next_dispatch_at])
  @@index([status, deadline_at])
  @@map("verification_runs")
}

// Who did what to a problem and when: Minor updates, Major drafts and every
// state change (GRD-50, GRD-117).
model ProblemHistory {
  id                 String                @id @default(uuid()) @db.Uuid
  problem_id         String                @db.Uuid
  // Null once a discarded draft is gone.
  problem_version_id String?               @db.Uuid
  type               ProblemHistoryType
  actor_id           String                @db.Uuid
  at                 DateTime              @default(now()) @db.Timestamptz(3)
  label              String                @db.VarChar(32)
  forced             Boolean               @default(false)
  // [{ field, old, new }]; text is cut to 2000 characters.
  changes            Json                  @default("[]")
  state_from         ProblemVersionStatus?
  state_to           ProblemVersionStatus?

  problem Problem         @relation(fields: [problem_id], references: [id], onDelete: Cascade)
  version ProblemVersion? @relation(fields: [problem_version_id], references: [id], onDelete: SetNull)
  actor   User            @relation("HistoryActor", fields: [actor_id], references: [id])

  @@index([problem_id, at(sort: Desc)])
  @@map("problem_history")
}

// One test: an input file and an expected output file in the private test
// bucket, keyed by the SHA-256 of their (normalised) content.
model TestCase {
  id                 String   @id @default(uuid()) @db.Uuid
  problem_version_id String   @db.Uuid
  // 1-based order; this is the order Judge runs the tests in.
  position           Int
  input_sha256       String   @db.VarChar(64)
  // Null while the expected output is still to be created (pasted without one,
  // or to be generated from a solution); a version cannot be published until
  // every testcase has one.
  output_sha256      String?  @db.VarChar(64)
  input_size_bytes   Int
  output_size_bytes  Int?
  // Samples are shown to solvers (content and judging feedback); the rest are hidden.
  is_sample          Boolean  @default(false)
  created_at         DateTime @default(now()) @db.Timestamptz(3)
  updated_at         DateTime @updatedAt @db.Timestamptz(3)

  version       ProblemVersion @relation(fields: [problem_version_id], references: [id], onDelete: Cascade)
  generate_runs GenerateRun[]

  @@index([problem_version_id, position])
  @@map("test_cases")
}

// The author's solution: proves the problem and its tests are right before
// publishing. Only owners and editors of the Space can ever read it.
model ReferenceSolution {
  id                 String   @id @default(uuid()) @db.Uuid
  problem_version_id String   @db.Uuid
  created_by_id      String   @db.Uuid
  language           Language
  source             String
  source_bytes       Int
  // The one the publish gate runs first. At most one per version.
  is_primary         Boolean  @default(false)
  created_at         DateTime @default(now()) @db.Timestamptz(3)
  updated_at         DateTime @updatedAt @db.Timestamptz(3)

  version    ProblemVersion @relation(fields: [problem_version_id], references: [id], onDelete: Cascade)
  created_by User           @relation(fields: [created_by_id], references: [id])

  @@index([problem_version_id])
  @@map("reference_solutions")
}

// --- Submissions (M3: GRD-43) -----------------------------------------------

enum SubmissionStatus {
  queued
  running
  completed
}

// Overall verdict, as in contracts/judge.openapi.yaml.
enum Verdict {
  AC
  WA
  TLE
  MLE
  RE
  CE
  OLE
  ISE
}

enum TestVerdict {
  AC
  WA
  TLE
  MLE
  RE
  OLE
  ISE
  SKIPPED
}

model Submission {
  id                 String           @id @default(uuid()) @db.Uuid
  user_id            String           @db.Uuid
  problem_id         String           @db.Uuid
  // The exact version that was submitted to: results never change when the
  // problem is edited later.
  problem_version_id String           @db.Uuid
  // The Track the solver was working in when they submitted (GRD-93); null when
  // none (staff trying a problem outside every Track) or once the Track is deleted.
  track_id           String?          @db.Uuid
  language           Language
  source             String
  source_bytes       Int
  status             SubmissionStatus @default(queued)
  // Set exactly when status = completed.
  verdict            Verdict?
  // Maximum over the tests that ran.
  time_ms            Int?
  memory_kb          Int?
  tests_passed       Int?
  tests_total        Int?
  compile_message    String?          @db.VarChar(8192)
  // Judge's system error code (ISE) or Core's (JUDGE_UNAVAILABLE).
  error_code         String?          @db.VarChar(64)
  judge_version      String?          @db.VarChar(64)
  // The current Judge job. A re-judge gets a new id; results for old ids are refused.
  judge_job_id       String?          @unique @db.Uuid
  dispatch_attempts  Int              @default(0)
  // While queued and not yet accepted by Judge: when to try handing it over again.
  next_dispatch_at   DateTime?        @db.Timestamptz(3)
  dispatched_at      DateTime?        @db.Timestamptz(3)
  judged_at          DateTime?        @db.Timestamptz(3)
  created_at         DateTime         @default(now()) @db.Timestamptz(3)
  updated_at         DateTime         @updatedAt @db.Timestamptz(3)

  user    User                   @relation(fields: [user_id], references: [id])
  problem Problem                @relation(fields: [problem_id], references: [id])
  version ProblemVersion         @relation(fields: [problem_version_id], references: [id])
  track   Track?                 @relation(fields: [track_id], references: [id], onDelete: SetNull)
  results SubmissionTestResult[]

  // "My submissions of this problem", "everyone's submissions of this problem", newest first.
  @@index([user_id, problem_id, created_at(sort: Desc)])
  @@index([problem_id, created_at(sort: Desc)])
  // "My best submission of this problem" (GRD-113): most tests passed, then the earliest.
  @@index([user_id, problem_id, status, tests_passed(sort: Desc), created_at(sort: Asc)])
  // Submissions made from a Track, newest first (the Space-wide pages).
  @@index([track_id, created_at(sort: Desc)])
  // The dispatcher looks for queued submissions that are due.
  @@index([status, next_dispatch_at])
  // How many submissions of one person are still waiting or running (GRD-55).
  @@index([user_id, status])
  @@map("submissions")
}

// One row per test that Judge reported. Never holds the content of a hidden
// test: previews are kept for sample tests only.
model SubmissionTestResult {
  id              String      @id @default(uuid()) @db.Uuid
  submission_id   String      @db.Uuid
  position        Int
  test_case_id    String?     @db.Uuid
  // Copied from our own test case when the result arrives (never trusted from Judge).
  is_sample       Boolean
  verdict         TestVerdict
  time_ms         Int
  memory_kb       Int
  exit_code       Int?
  signal          Int?
  stdout_preview  String?     @db.VarChar(1024)
  checker_message String?     @db.VarChar(256)

  submission Submission            @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  output     SubmissionTestOutput?

  @@unique([submission_id, position])
  @@map("submission_test_results")
}

// What the program printed on a test, as far as Judge kept it (GRD-93). Hidden
// tests included, so it is only ever read for people who may see hidden tests
// (owner, administrator, editor, observer), never for solvers.
model SubmissionTestOutput {
  result_id         String  @id @db.Uuid
  stdout            String?
  // Full size, so the web app can say the text was cut.
  stdout_size_bytes BigInt?
  stderr            String?
  stderr_size_bytes BigInt?

  result SubmissionTestResult @relation(fields: [result_id], references: [id], onDelete: Cascade)

  @@map("submission_test_outputs")
}

// --- Tracks and Collections (M3: GRD-77) ------------------------------------
//
// Space > Track > Collection > Problem. Solvers reach problems only through a
// Track they may see (GRD-81); owners and editors see everything.

// space: everyone who can see the Space sees the Track. members: only people
// added to the Track (owners and editors always see it).
enum TrackVisibility {
  space
  members
}

model Track {
  id          String          @id @default(uuid()) @db.Uuid
  space_id    String          @db.Uuid
  name        String          @db.VarChar(80)
  // Unique inside the Space; part of /spaces/<space>/tracks/<slug>.
  slug        String          @db.VarChar(64)
  description String          @default("") @db.VarChar(500)
  // 1-based order among the Space's Tracks.
  position    Int
  visibility  TrackVisibility @default(space)
  // Archiving hides the Track from solvers; nothing is deleted.
  archived_at DateTime?       @db.Timestamptz(3)
  created_at  DateTime        @default(now()) @db.Timestamptz(3)
  updated_at  DateTime        @updatedAt @db.Timestamptz(3)

  space       Space             @relation(fields: [space_id], references: [id], onDelete: Cascade)
  collections TrackCollection[]
  members     TrackMember[]
  invites     Invite[]
  submissions Submission[]

  @@unique([space_id, slug])
  @@index([space_id, position])
  @@map("tracks")
}

// A set of problems. May belong to no Track (then only owners and editors see it).
model Collection {
  id          String    @id @default(uuid()) @db.Uuid
  space_id    String    @db.Uuid
  name        String    @db.VarChar(80)
  slug        String    @db.VarChar(64)
  description String    @default("") @db.VarChar(500)
  archived_at DateTime? @db.Timestamptz(3)
  created_at  DateTime  @default(now()) @db.Timestamptz(3)
  updated_at  DateTime  @updatedAt @db.Timestamptz(3)

  space    Space               @relation(fields: [space_id], references: [id], onDelete: Cascade)
  tracks   TrackCollection[]
  problems CollectionProblem[]

  @@unique([space_id, slug])
  @@map("collections")
}

// A Collection can sit in several Tracks, each with its own order.
model TrackCollection {
  track_id      String @db.Uuid
  collection_id String @db.Uuid
  position      Int

  track      Track      @relation(fields: [track_id], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collection_id], references: [id], onDelete: Cascade)

  @@id([track_id, collection_id])
  @@index([track_id, position])
  @@index([collection_id])
  @@map("track_collections")
}

// A problem can sit in several Collections. Removing a problem from a
// Collection never deletes the problem.
model CollectionProblem {
  collection_id String @db.Uuid
  problem_id    String @db.Uuid
  position      Int

  collection Collection @relation(fields: [collection_id], references: [id], onDelete: Cascade)
  problem    Problem    @relation(fields: [problem_id], references: [id], onDelete: Cascade)

  @@id([collection_id, problem_id])
  @@index([collection_id, position])
  @@index([problem_id])
  @@map("collection_problems")
}

model TrackMember {
  track_id   String   @db.Uuid
  user_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(3)

  track Track @relation(fields: [track_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([track_id, user_id])
  @@index([user_id])
  @@map("track_members")
}

// Who did what to access (GRD-80): Track invitations, revocations and removals.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  space_id   String   @db.Uuid
  actor_id   String?  @db.Uuid
  // e.g. track.invite_created, track.invite_revoked, track.member_removed
  action     String   @db.VarChar(64)
  // The Track (or other object) the action was about; no foreign key so the record outlives it.
  target_id  String?  @db.Uuid
  data       Json     @default("{}")
  created_at DateTime @default(now()) @db.Timestamptz(3)

  space Space @relation(fields: [space_id], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actor_id], references: [id], onDelete: SetNull)

  @@index([space_id, created_at(sort: Desc)])
  @@index([target_id, created_at(sort: Desc)])
  @@map("audit_logs")
}

// --- Generating expected outputs from a solution (M3: GRD-108) -----------------
//
// One job per request, one run per testcase (so the web app can show progress,
// stop, and keep what finished). Results are stored as content-addressed test
// files and only become part of the problem when the author saves the page.

enum GenerateJobStatus {
  running
  completed
  stopped
  timed_out
  failed
}

enum GenerateRunStatus {
  queued
  running
  done
  failed
}

model GenerateJob {
  id                 String            @id @default(uuid()) @db.Uuid
  problem_version_id String            @db.Uuid
  created_by_id      String            @db.Uuid
  // The solution as it was when the job started.
  language           Language
  source             String
  status             GenerateJobStatus @default(running)
  // COMPILE_ERROR, JUDGE_UNAVAILABLE, ... when status = failed.
  error_code         String?           @db.VarChar(64)
  // First line of the compiler message, for the author.
  error_message      String?           @db.VarChar(300)
  deadline_at        DateTime          @db.Timestamptz(3)
  created_at         DateTime          @default(now()) @db.Timestamptz(3)
  finished_at        DateTime?         @db.Timestamptz(3)

  version    ProblemVersion @relation(fields: [problem_version_id], references: [id], onDelete: Cascade)
  created_by User           @relation("GenerateJobAuthor", fields: [created_by_id], references: [id])
  runs       GenerateRun[]

  @@index([problem_version_id, status])
  @@index([created_at])
  @@map("generate_jobs")
}

model GenerateRun {
  id                String            @id @default(uuid()) @db.Uuid
  job_id            String            @db.Uuid
  test_case_id      String            @db.Uuid
  position          Int
  status            GenerateRunStatus @default(queued)
  judge_job_id      String?           @unique @db.Uuid
  attempts          Int               @default(0)
  next_dispatch_at  DateTime?         @db.Timestamptz(3)
  // Judge's verdict for this test when it did not produce an output (TLE, MLE, RE, OLE, ISE).
  verdict           TestVerdict?
  time_ms           Int?
  memory_kb         Int?
  stderr            String?           @db.VarChar(4096)
  output_sha256     String?           @db.VarChar(64)
  output_size_bytes Int?
  // Same as the current expected output, comparing the way Judge does.
  same_as_current   Boolean?
  error_code        String?           @db.VarChar(64)
  finished_at       DateTime?         @db.Timestamptz(3)

  job       GenerateJob @relation(fields: [job_id], references: [id], onDelete: Cascade)
  test_case TestCase    @relation(fields: [test_case_id], references: [id], onDelete: Cascade)

  @@index([job_id, position])
  @@map("generate_runs")
}

// --- AI testcase generation (GRD-124) -----------------------------------------
// The author brings their own provider key. The model only writes inputs; the
// expected outputs come from running a reference solution on Judge. Items are
// drafts: they are not TestCase rows and become part of the problem only when
// the author saves the testcases page with a reference to them.

enum AiProvider {
  gemini
  claude
}

enum AiTestJobStatus {
  generating
  computing
  completed
  failed
}

enum AiTestItemStatus {
  pending
  ok
  skipped
}

model UserAiCredential {
  id             String     @id @default(uuid()) @db.Uuid
  user_id        String     @db.Uuid
  provider       AiProvider
  // AES-256-GCM of the API key; the key itself is never stored or returned.
  key_ciphertext Bytes
  key_nonce      Bytes
  key_tag        Bytes
  // Which entry of AI_KEY_ENCRYPTION_KEYS encrypted it.
  key_id         String     @db.VarChar(64)
  // Last four characters, the only part ever shown back.
  last4          String     @db.VarChar(4)
  created_at     DateTime   @default(now()) @db.Timestamptz(3)
  updated_at     DateTime   @default(now()) @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, provider])
  @@map("user_ai_credentials")
}

model AiTestJob {
  id                 String          @id @default(uuid()) @db.Uuid
  problem_version_id String          @db.Uuid
  created_by_id      String          @db.Uuid
  provider           AiProvider
  requested_count    Int
  // edge, max, random; empty means "follow the statement".
  categories         String[]
  include_solution   Boolean         @default(false)
  judge_job_id       String?         @unique @db.Uuid
  status             AiTestJobStatus @default(generating)
  // AI_KEY_INVALID, AI_QUOTA_EXCEEDED, AI_BAD_RESPONSE, COMPILE_ERROR, JUDGE_UNAVAILABLE, ...
  error_code         String?         @db.VarChar(64)
  error_message      String?         @db.VarChar(300)
  deadline_at        DateTime        @db.Timestamptz(3)
  created_at         DateTime        @default(now()) @db.Timestamptz(3)
  finished_at        DateTime?       @db.Timestamptz(3)

  version    ProblemVersion @relation(fields: [problem_version_id], references: [id], onDelete: Cascade)
  created_by User           @relation("AiTestJobAuthor", fields: [created_by_id], references: [id])
  items      AiTestItem[]

  @@index([problem_version_id, status])
  @@index([created_at])
  @@map("ai_test_jobs")
}

model AiTestItem {
  id                String           @id @default(uuid()) @db.Uuid
  job_id            String           @db.Uuid
  position          Int
  status            AiTestItemStatus @default(pending)
  // Null when the model's text was refused before it was stored (see skip_reason).
  input_sha256      String?          @db.VarChar(64)
  input_size_bytes  Int?
  output_sha256     String?          @db.VarChar(64)
  output_size_bytes Int?
  // Why the item was skipped: a format problem, or Judge's verdict (RE, TLE, ...).
  skip_reason       String?          @db.VarChar(200)

  job AiTestJob @relation(fields: [job_id], references: [id], onDelete: Cascade)

  @@index([job_id, position])
  @@map("ai_test_items")
}

// --- Platform administration (M4: GRD-58) --------------------------------------
//
// A role above the Spaces, reports from users, and the record of what the
// administrators did. Docs: docs/platform-admin.md.

enum PlatformRole {
  user
  admin
}

enum ReportStatus {
  open
  dismissed
  actioned
}

enum ReportCategory {
  abuse
  copyright
  cheating
  other
}

// A user's report of a problem they can see.
model ProblemReport {
  id              String         @id @default(uuid()) @db.Uuid
  problem_id      String         @db.Uuid
  reporter_id     String         @db.Uuid
  category        ReportCategory @default(other)
  reason          String         @db.VarChar(1000)
  status          ReportStatus   @default(open)
  resolved_by_id  String?        @db.Uuid
  resolved_at     DateTime?      @db.Timestamptz(3)
  resolution_note String?        @db.VarChar(500)
  created_at      DateTime       @default(now()) @db.Timestamptz(3)

  problem     Problem @relation(fields: [problem_id], references: [id], onDelete: Cascade)
  reporter    User    @relation("ReportReporter", fields: [reporter_id], references: [id], onDelete: Cascade)
  resolved_by User?   @relation("ReportResolver", fields: [resolved_by_id], references: [id], onDelete: SetNull)

  // Reports waiting for an administrator, oldest first; reports of one problem.
  @@index([status, created_at])
  @@index([problem_id, created_at(sort: Desc)])
  // One open report per person and problem is kept by the service: asking again changes nothing.
  @@map("problem_reports")
}

// Who did what to what, on the platform level. Has no foreign key to the object,
// so the record outlives it; the actor is null for work done on the command line.
model PlatformAuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actor_id     String?  @db.Uuid
  // e.g. problem.unpublished, space.suspended, user.suspended, admin.granted
  action       String   @db.VarChar(64)
  // problem, space, user or report
  target_type  String   @db.VarChar(16)
  target_id    String?  @db.Uuid
  // What a person reads: the slug or username at the time.
  target_label String   @db.VarChar(128)
  data         Json     @default("{}")
  created_at   DateTime @default(now()) @db.Timestamptz(3)

  actor User? @relation(fields: [actor_id], references: [id], onDelete: SetNull)

  @@index([created_at(sort: Desc)])
  @@index([target_type, target_id, created_at(sort: Desc)])
  @@index([actor_id, created_at(sort: Desc)])
  @@map("platform_audit_logs")
}
